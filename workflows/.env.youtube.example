# YouTube Content Manager AI Agent - Environment Configuration
# Copy this file to .env.youtube and fill in your credentials

# =============================================================================
# GOOGLE GEMINI AI (Required - FREE)
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# GOOGLE CLOUD SERVICE ACCOUNT (Required for Google Drive)
# =============================================================================
# Create service account and download JSON key from:
# https://console.cloud.google.com/iam-admin/serviceaccounts
#
# Then paste the JSON content here or save to a file and provide path:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json

# Google Drive folder for storing content
# Create a folder and share it with your service account email
GOOGLE_DRIVE_FOLDER_NAME=YouTube Content
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# =============================================================================
# NOTION API (Required)
# =============================================================================
# Create integration at: https://www.notion.so/my-integrations
NOTION_API_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database IDs
# Create these databases and share with your integration
NOTION_CONTENT_CALENDAR_DB_ID=your_database_id_here

# Database structure - Create these properties in your Notion database:
# - Title (Title)
# - Status (Select: Draft, Script Ready, Metadata Done, Published)
# - Niche (Text)
# - Target Audience (Text)
# - Created Date (Date)
# - Publish Date (Date)
# - Keywords (Multi-select)
# - Google Drive Link (URL)
# - Viral Potential (Number)
# - Video Length (Select: Short, Medium, Long)
# - Notes (Text)

# =============================================================================
# GMAIL (Required for notifications)
# =============================================================================
# Configure OAuth2 in n8n or use App Password
GMAIL_USER_EMAIL=your-email@gmail.com
NOTIFICATION_RECIPIENT_EMAIL=recipient@example.com

# If using App Password (recommended for Gmail):
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_16_character_app_password

# =============================================================================
# OPENAI API (Optional - for advanced analysis)
# =============================================================================
# Get API key from: https://platform.openai.com/api-keys
# Only used for complex analysis - can leave empty to save costs
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Set to false to disable OpenAI and only use Gemini (recommended for free usage)
ENABLE_OPENAI_ANALYSIS=false

# =============================================================================
# WORKFLOW SETTINGS
# =============================================================================

# Default user inputs (can be overridden at runtime)
DEFAULT_NICHE=General Content
DEFAULT_TARGET_AUDIENCE=General Audience
DEFAULT_TONE=Educational and Engaging
DEFAULT_VIDEO_LENGTH=10-15 minutes

# AI Model Settings
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# Enable/disable features
ENABLE_GOOGLE_DRIVE=true
ENABLE_NOTION=true
ENABLE_GMAIL_NOTIFICATIONS=true
ENABLE_THUMBNAIL_GENERATION=true

# =============================================================================
# CHANNEL SETTINGS (Optional)
# =============================================================================
# Your YouTube channel information (for context in AI prompts)
YOUTUBE_CHANNEL_NAME=Your Channel Name
YOUTUBE_CHANNEL_NICHE=Your Main Niche
YOUTUBE_CHANNEL_STYLE=Your Content Style
YOUTUBE_SUBSCRIBER_COUNT=Your Subscriber Count

# Common keywords for your channel (comma-separated)
CHANNEL_KEYWORDS=keyword1,keyword2,keyword3

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Retry settings
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Rate limiting (to stay within free tier limits)
GEMINI_REQUESTS_PER_MINUTE=50
ENABLE_RATE_LIMITING=true

# Logging
LOG_LEVEL=info  # debug, info, warn, error
ENABLE_EXECUTION_LOGS=true

# =============================================================================
# DEVELOPMENT/TESTING
# =============================================================================
# Set to true to run in test mode (doesn't save to Drive/Notion)
TEST_MODE=false

# Mock responses for testing without using API credits
USE_MOCK_AI_RESPONSES=false

# =============================================================================
# NOTES
# =============================================================================
#
# REQUIRED SERVICES (FREE):
# - Google Gemini API (free tier)
# - Google Drive (15GB free)
# - Notion (free tier)
# - Gmail (free)
#
# OPTIONAL SERVICES (PAID):
# - OpenAI API (~$5-20/month for heavy usage)
#
# TOTAL FREE TIER COST: $0/month
#
# =============================================================================
