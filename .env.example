# Gift Advisor Workflow Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API (Required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# SerpAPI (Optional but recommended)
# Get your key from: https://serpapi.com/
# Free tier: 100 searches/month
SERPAPI_API_KEY=your_serpapi_api_key_here

# n8n Webhook URL
# This will be generated when you import the workflow
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/gift-advisor

# Alternative AI APIs (if not using OpenAI)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# CLAUDE_API_KEY=your_claude_key_here

# Additional Product Search APIs (Optional)
# AMAZON_API_KEY=your_amazon_api_key_here
# EBAY_API_KEY=your_ebay_api_key_here
