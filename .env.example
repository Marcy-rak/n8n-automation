# =====================================================
# Database Configuration
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_workflow
DB_USER=postgres
DB_PASSWORD=your_password_here

# =====================================================
# Grok API Configuration
# =====================================================
GROK_API_KEY=your_grok_api_key_here
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-beta

# =====================================================
# Trading Configuration
# =====================================================
CONFIDENCE_THRESHOLD=0.7
SCHEDULER_INTERVAL_MINUTES=30
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY

# =====================================================
# Notification Configuration
# =====================================================
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com

# WhatsApp (Twilio)
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1234567890

# =====================================================
# Embedding Configuration (OpenAI for RAG)
# =====================================================
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-ada-002

# =====================================================
# Email Summary Configuration
# =====================================================
# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# Email Summary Settings
EMAIL_LABEL=ToSummarize
EMAIL_RECIPIENT=your-email@gmail.com
EMAIL_CONFIDENCE_THRESHOLD=0.6
EMAIL_SUMMARY_CRON=0 7 * * *

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=info
LOG_FILE=./logs/trading-workflow.log
